PORT=4000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database configuration (PostgreSQL direct connection, optional if using Supabase client)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=yourself_music

# Security
JWT_SECRET=super_secret_jwt_key_yourself_music_2026
JWT_EXPIRES_IN=7d

# CORS
CLIENT_WEB_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174

# ============================================================================
# MERCADO PAGO (Checkout API / Custom Checkout)
# ============================================================================
# MERCADOPAGO_PUBLIC_KEY: Usada en el cliente para generar el token de tarjeta con MercadoPago.js v2
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MERCADOPAGO_ACCESS_TOKEN: Usado ESTRICTAMENTE en el servidor para procesar cobros reales
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
# MERCADOPAGO_WEBHOOK_SECRET: Clave secreta para verificar la firma HMAC-SHA256 de notificaciones Webhook
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret_de_mercadopago

# ============================================================================
# SMTP (Envío de Comprobante / Recibo al Correo del Cliente)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourself@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion_gmail
SMTP_FROM="YourSelf Music <yourself@gmail.com>"
